{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ogadriver.ng/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ogadriver.ng/api",
        "EXPO_PUBLIC_PAYSTACK_KEY": "pk_live_a92fa363b1192c08410f198c64b2796cb96425cd",
        "EXPO_PUBLIC_LOCATIONIQ_KEY": "pk.8ae3192c04f86a50c49464280dfb044e"
      }
    },
    "production-apk": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ogadriver.ng/api",
        "EXPO_PUBLIC_PAYSTACK_KEY": "pk_live_a92fa363b1192c08410f198c64b2796cb96425cd",
        "EXPO_PUBLIC_LOCATIONIQ_KEY": "pk.8ae3192c04f86a50c49464280dfb044e"
      }
    },
    "hirer-preview": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "hirer",
        "EXPO_PUBLIC_API_URL": "https://ogadriver.ng/api",
        "EXPO_PUBLIC_PAYSTACK_KEY": "pk_live_a92fa363b1192c08410f198c64b2796cb96425cd",
        "EXPO_PUBLIC_LOCATIONIQ_KEY": "pk.8ae3192c04f86a50c49464280dfb044e"
      }
    },
    "driver-preview": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "driver",
        "EXPO_PUBLIC_API_URL": "https://ogadriver.ng/api",
        "EXPO_PUBLIC_PAYSTACK_KEY": "pk_live_a92fa363b1192c08410f198c64b2796cb96425cd",
        "EXPO_PUBLIC_LOCATIONIQ_KEY": "pk.8ae3192c04f86a50c49464280dfb044e"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ogadriver.ng/api",
        "EXPO_PUBLIC_PAYSTACK_KEY": "pk_live_a92fa363b1192c08410f198c64b2796cb96425cd",
        "EXPO_PUBLIC_LOCATIONIQ_KEY": "pk.8ae3192c04f86a50c49464280dfb044e"
      }
    },
    "driver-production": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "driver"
      }
    },
    "hirer-production": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "hirer"
      }
    }
  }
}
