APP_NAME=OgaDriver
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ogadriver.ng

# Frontend Configuration
FRONTEND_URL=https://ogadriver.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ogadriver
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=https://ogadriver.ng/api
VITE_API_URL=https://ogadriver.ng
VITE_FRONTEND_URL=https://ogadriver.ng

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Payment Gateway (Paystack)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL="${APP_URL}/api/payments/callback"
PAYMENT_WEBHOOK_SECRET=

# Payment Gateway (OPay/Moniepoint)
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=
MONIEPOINT_SECRET_KEY=
MONIEPOINT_API_KEY=

# Identity Verification
NIMC_API_KEY=
BVN_VALIDATION_KEY=

# Site Configuration
SITE_NAME=OgaDriver
SITE_URL=https://ogadriver.ng
SITE_DESCRIPTION="Nigeria's premier peer-to-peer operative directory and matchmaking platform."
CONTACT_EMAIL=command@ogadriver.ng
SUPPORT_EMAIL=sos@ogadriver.ng
CONTACT_PHONE="+234 800 123 4567"
ADDRESS="HQ, Lagos Island, Lagos, Nigeria"

# AWS Configuration for Textract OCR
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# AI Verification System Configuration
AI_SERVICE_PROVIDER=google
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SPEECH_API_KEY=
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+234XXXXXXXXXX

# AI Service Endpoints (Optional - for custom AI services)
AI_GUARANTOR_CALL_ENDPOINT=
AI_ANALYSIS_ENDPOINT=
AI_LOCATION_CERTIFICATION_ENDPOINT=
